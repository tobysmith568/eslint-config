{
  "name": "@tobysmith568/eslint-config",
  "version": "0.0.0",
  "author": {
    "name": "Toby Smith",
    "email": "contact@tobythe.dev",
    "url": "https://tobysmith.uk"
  },
  "license": "ISC",
  "description": "Toby Smith's (tobysmith568) ESLint config",
  "keywords": [
    "eslint",
    "config",
    "tobysmith568"
  ],
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/configs/node.d.ts",
      "default": "./dist/configs/node.js"
    },
    "./browser": {
      "types": "./dist/configs/browser.d.ts",
      "default": "./dist/configs/browser.js"
    },
    "./prettier": {
      "types": "./dist/configs/prettier.d.ts",
      "default": "./dist/configs/prettier.js"
    },
    "./react": {
      "types": "./dist/configs/react.d.ts",
      "default": "./dist/configs/react.js"
    },
    "./next": {
      "types": "./dist/configs/next.d.ts",
      "default": "./dist/configs/next.js"
    },
    "./jest": {
      "types": "./dist/configs/jest.d.ts",
      "default": "./dist/configs/jest.js"
    },
    "./vitest": {
      "types": "./dist/configs/vitest.d.ts",
      "default": "./dist/configs/vitest.js"
    },
    "./playwright": {
      "types": "./dist/configs/playwright.d.ts",
      "default": "./dist/configs/playwright.js"
    },
    "./cypress": {
      "types": "./dist/configs/cypress.d.ts",
      "default": "./dist/configs/cypress.js"
    },
    "./testing-library/dom": {
      "types": "./dist/configs/testing-library/dom.d.ts",
      "default": "./dist/configs/testing-library/dom.js"
    },
    "./testing-library/react": {
      "types": "./dist/configs/testing-library/react.d.ts",
      "default": "./dist/configs/testing-library/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "prettier": "@tobysmith568/prettier-config",
  "homepage": "https://github.com/tobysmith568/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobysmith568/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/tobysmith568/eslint-config/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "bun run typecheck && bun run build && bun test"
  },
  "peerDependencies": {
    "eslint": "^9.22.0 || ^10.0.0"
  },
  "dependencies": {
    "@eslint/js": "^9.39.3",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.1.0",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-testing-library": "^7.16.0",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.56.1"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "devDependencies": {
    "@license-cop/permissive": "^2.2.1",
    "@tobysmith568/prettier-config": "^2.2.1",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.3",
    "license-cop": "^2.2.1",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
