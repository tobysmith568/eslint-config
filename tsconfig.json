{
  "compilerOptions": {
    "target": "ES2022",
    "types": ["bun"],
    "module": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true
  }
}
